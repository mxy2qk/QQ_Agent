# Fill locally; never send credentials in chat or commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

MAX_AGENT_STEPS=5
MAX_TOOL_CALLS=5
TOOL_TIMEOUT_SECONDS=30
AGENT_TIMEOUT_SECONDS=120
MODEL_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO

# CLI only; remember commands are explicit, no background inference of private facts.
CHANNEL_MODE=cli
QQ_ADAPTER_MODE=unselected

# Phase 2: approved policy, 7 days including session history/checkpoints.
DATABASE_PATH=data/agent.db
CHECKPOINT_DB_PATH=data/checkpoints.db
MESSAGE_RETENTION_DAYS=7
MEMORY_EXTRACTION_ENABLED=true

# Phase 3: opt-in public, unofficial read-only adapters. Approved locally.
PUBLIC_SOURCES_ENABLED=false
PIXIV_IMAGES_ENABLED=false
PIXIV_CACHE_DIR=data/pixiv-cache
SOURCE_TIMEOUT_SECONDS=15
SOURCE_INTERVAL_SECONDS=2

# Phase 4: NapCat OneBot forward WS; disabled until authorized/configured locally.
# QQ_ADAPTER_MODE=onebot
QQ_WS_URL=
QQ_ACCESS_TOKEN=
QQ_SELF_ID=
QQ_ALLOWED_GROUPS=[]
# Optional extra filter within allowed groups; [] permits all members of those groups.
QQ_ALLOWED_GROUP_USERS=[]
# Managers for /auto mode and limits; independent of ordinary chat permissions.
QQ_CONTROL_USERS=[]
# Opt in only after authorization: read allowed members' ordinary group text;
# still reply only to actual bot mentions. Kept for MESSAGE_RETENTION_DAYS.
QQ_GROUP_CONTEXT_ENABLED=false
# Friend private-chat allowlist only; independent from group member filtering.
QQ_ALLOWED_USERS=[]
QQ_PRIVATE_ENABLED=true
QQ_LIVE_ENABLED=false
QQ_ACTION_TIMEOUT_SECONDS=15
QQ_REPLY_INTERVAL_SECONDS=3
QQ_RECONNECT_MAX_SECONDS=30
