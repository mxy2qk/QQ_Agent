# Fill locally; never send credentials in chat or commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

MAX_AGENT_STEPS=5
MAX_TOOL_CALLS=5
TOOL_TIMEOUT_SECONDS=30
AGENT_TIMEOUT_SECONDS=120
MODEL_TIMEOUT_SECONDS=60
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# Phase 1: CLI and in-process history only. No automatic memory extraction.
CHANNEL_MODE=cli
QQ_ADAPTER_MODE=unselected
